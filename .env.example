# --- Base de datos ---------------------------------------------------------
# Postgres. El despliegue de referencia es Neon creada desde Vercel
# (Storage → Neon): en ese caso estas dos variables las inyecta Vercel solo y
# NO hay que tocarlas aquí. Esto es para local.
#
# DATABASE_URL es la conexión que usa la app. En Neon es la "pooled", la que
# lleva -pooler en el host.
DATABASE_URL="postgresql://user:pass@host:5432/fantasy"

# Conexión DIRECTA (sin pooler). Solo la usan las migraciones: PgBouncer en
# modo transacción no lleva bien el DDL. En Neon es la que acaba en _UNPOOLED.
# Si la dejas vacía se usa DATABASE_URL, que es lo correcto con un Postgres
# local, donde no hay pooler que valga.
DATABASE_URL_UNPOOLED=""

# Opcionales, con valores por defecto sensatos:
# DATABASE_PREPARE=true   reactiva los prepared statements. Solo si apuntas a
#                         un Postgres directo, NUNCA a través de un pooler.
# DATABASE_POOL_MAX=5     tamaño del pool. Por defecto 1 en Vercel y 5 fuera.

# Clave AES-256-GCM para cifrar el refresh token en reposo (32 bytes en hex).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Secreto para proteger la ruta de cron (/api/cron/sync). Cualquier cadena larga y aleatoria.
CRON_SECRET=""


# --- Login -----------------------------------------------------------------
# Credenciales de LaLiga Fantasy Oficial. Solo las usa `npm run sync -- --login`
# y solo una vez: a partir de ahí se guarda el refresh token CIFRADO en la base
# de datos y la contraseña deja de hacer falta. Bórrala después.
#
# NO hacen falta en Vercel: el login desde el navegador (/setup/login) las pide
# por formulario y no las guarda en ningún sitio.
FANTASY_EMAIL=""
FANTASY_PASSWORD=""

# Parámetros del tenant Azure B2C de LaLiga. YA TIENEN VALOR POR DEFECTO en
# lib/fantasy/auth.ts, así que puedes dejarlos vacíos y probar el login tal
# cual. Solo hay que rellenarlos si los de por defecto dejan de valer.
#
# Ojo: el login por contraseña (ROPC) solo sirve para cuentas locales, las de
# email y contraseña. Si entras al juego con Google, Apple o Facebook esto va a
# fallar y no es un bug. Ver docs/reglas.md.
FANTASY_B2C_TOKEN_URL=""
FANTASY_B2C_CLIENT_ID=""
FANTASY_B2C_SCOPE=""
# Política (user flow) de B2C. Por defecto la de contraseña.
FANTASY_B2C_POLICY=""

# Base de la API del juego. Por defecto https://fantasy-api.llt-services.com
# Si la sincronización da 404 en TODAS las rutas, prueba con el sufijo /api:
# es la única discrepancia sin confirmar del catálogo de endpoints.
FANTASY_API_BASE=""


# --- Identificadores -------------------------------------------------------
# Se descubren con `npm run sync -- --dry-run`.
FANTASY_LEAGUE_ID=""
# Tu equipo dentro de la liga. La sincronización intenta detectarlo solo y
# avisa si no lo consigue.
FANTASY_TEAM_ID=""
# Competición. Por defecto 1; confirmar en la fase 0.
FANTASY_COMPETITION_ID="1"


# --- Reglas del juego (ver docs/reglas.md) ---------------------------------
# Cuánto sube la cláusula por cada euro invertido en blindar. Es la `k` de la
# fórmula de blindaje y NO se asume ningún valor: sin esto, el motor de
# blindaje se niega a funcionar y la interfaz dice qué falta.
# Cómo averiguarlo: blinda a un jugador barato en la app oficial y mira cuánto
# sube su cláusula por cada euro pagado.
FANTASY_CLAUSE_MULTIPLIER=""

# Presupuesto inicial de la liga. Por defecto 200.000.000. Si es otro, el motor
# de caja lo detecta solo en el residuo de la calibración.
FANTASY_INITIAL_BUDGET=""


# --- Alertas (opcional, fase 4) --------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
