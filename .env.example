# --- Base de datos ---------------------------------------------------------
# Postgres. El despliegue de referencia es Neon creada desde Vercel
# (Storage → Neon): en ese caso estas dos variables las inyecta Vercel solo y
# NO hay que tocarlas aquí. Esto es para local.
#
# DATABASE_URL es la conexión que usa la app. En Neon es la "pooled", la que
# lleva -pooler en el host.
DATABASE_URL="postgresql://user:pass@host:5432/fantasy"

# Conexión DIRECTA (sin pooler). Solo la usan las migraciones: PgBouncer en
# modo transacción no lleva bien el DDL. En Neon es la que acaba en _UNPOOLED.
# Si la dejas vacía se usa DATABASE_URL, que es lo correcto con un Postgres
# local, donde no hay pooler que valga.
DATABASE_URL_UNPOOLED=""

# Opcionales, con valores por defecto sensatos:
# DATABASE_PREPARE=true   reactiva los prepared statements. Solo si apuntas a
#                         un Postgres directo, NUNCA a través de un pooler.
# DATABASE_POOL_MAX=5     tamaño del pool. Por defecto 1 en Vercel y 5 fuera.

# Clave AES-256-GCM para cifrar el refresh token en reposo (32 bytes en hex).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Secreto para proteger la ruta de cron (/api/cron/sync). Cualquier cadena larga y aleatoria.
CRON_SECRET=""


# --- Login -----------------------------------------------------------------
# Credenciales de LaLiga Fantasy Oficial. Solo las usa `npm run sync -- --login`
# y solo una vez: a partir de ahí se guarda el refresh token CIFRADO en la base
# de datos y la contraseña deja de hacer falta. Bórrala después.
#
# NO hacen falta en Vercel: el login desde el navegador (/setup/login) las pide
# por formulario y no las guarda en ningún sitio.
FANTASY_EMAIL=""
FANTASY_PASSWORD=""

# Parámetros del tenant Azure B2C de LaLiga. YA TIENEN VALOR POR DEFECTO en
# lib/fantasy/auth.ts, así que puedes dejarlos vacíos y probar el login tal
# cual. Solo hay que rellenarlos si los de por defecto dejan de valer.
#
# Ojo: el login por contraseña (ROPC) solo sirve para cuentas locales, las de
# email y contraseña. Si entras al juego con Google, Apple o Facebook esto va a
# fallar y no es un bug. Ver docs/reglas.md.
FANTASY_B2C_TOKEN_URL=""
FANTASY_B2C_CLIENT_ID=""
FANTASY_B2C_SCOPE=""
# Política (user flow) de B2C. Por defecto la de contraseña.
FANTASY_B2C_POLICY=""

# Flujo interactivo (authorization code + PKCE), el único que sirve para
# cuentas de Google, Apple o Facebook. También con valores por defecto.
FANTASY_B2C_INTERACTIVE_POLICY=""
# A dónde vuelve LaLiga con el código. Por defecto el esquema de su app móvil,
# que obliga a copiar la URL a mano una vez. Si algún día se confirma que el
# tenant acepta el origen del despliegue, se pone aquí y desaparece ese paso.
FANTASY_B2C_REDIRECT_URI=""

# Base de la API del juego. Por defecto https://fantasy-api.llt-services.com/api
# El sufijo /api es obligatorio: confirmado contra la API real. Solo hay que
# tocar esto si vuelve a moverse; el diagnóstico de /setup lo detecta.
FANTASY_API_BASE=""


# --- Identificadores -------------------------------------------------------
# OJO: estas cinco ya NO son la fuente de verdad. La liga, tu equipo dentro de
# ella y las reglas propias de esa liga viven ahora en la tabla
# `account_leagues`, porque son propiedades de una liga y no del proceso que la
# sirve. La sincronización las descubre y las anota sola.
#
# Se conservan como respaldo del despliegue de un solo dueño: si están puestas,
# se usan cuando la base de datos todavía no tiene nada anotado. Lo guardado
# manda sobre lo que haya aquí.
FANTASY_LEAGUE_ID=""
# Tu equipo dentro de la liga. La sincronización intenta detectarlo solo y
# avisa si no lo consigue.
FANTASY_TEAM_ID=""
# Competición. Por defecto 1; confirmado contra la API.
FANTASY_COMPETITION_ID="1"


# --- Reglas del juego (ver docs/reglas.md) ---------------------------------
# También en `account_leagues`, una fila por liga. Estas son solo el valor por
# defecto para quien no tenga nada anotado.
#
# Cuánto sube la cláusula por cada euro invertido en blindar. Es la `k` de la
# fórmula de blindaje. CONFIRMADO = 2: pagar 10M sobre una cláusula de 30M la
# deja en 50M. Ya es el valor por defecto; esto solo hace falta si tu liga usa
# otro o el juego lo cambia.
FANTASY_CLAUSE_MULTIPLIER=""

# Presupuesto inicial de la liga. Por defecto 200.000.000. Si es otro, el motor
# de caja lo detecta solo en el residuo de la calibración.
FANTASY_INITIAL_BUDGET=""


# --- Alertas (opcional, fase 4) --------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""


# --- Cómo se paga esto -----------------------------------------------------
# La app es gratis, sin cuentas y sin rastreo. Estas variables rellenan el
# colofón del pie; si las dejas vacías, el hueco se queda reservado y
# ofrecido, que es justo lo que se quiere de un espacio libre.
#
# Adónde va el botón de "invitar a un café" (Ko-fi, GitHub Sponsors, Bizum...).
# Sin ella no se enseña ningún botón, ni en el pie ni en el menú.
NEXT_PUBLIC_DONATE_URL=""

# A quién escribe quien quiera anunciarse. Vale un mailto: o una URL.
NEXT_PUBLIC_SPONSOR_CONTACT=""

# El patrocinador actual, si lo hay. Es TEXTO y un enlace, nunca un script de
# terceros: la app no carga nada que pueda rastrear a quien la usa.
NEXT_PUBLIC_SPONSOR_NAME=""
NEXT_PUBLIC_SPONSOR_CLAIM=""
NEXT_PUBLIC_SPONSOR_URL=""


# --- Identidad de la aplicación (fase 1b) -----------------------------------
# Mientras esto esté vacío, la app NO pide iniciar sesión y se comporta como el
# despliegue de un solo dueño. El login se enciende solo en cuanto haya UNO de
# los dos proveedores completo.
#
# Secreto de firma de sesiones. Obligatorio en cuanto haya proveedor.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google. Se crean en Google Cloud → Credenciales → ID de cliente OAuth, con
# la URL de retorno https://TU-APP/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Enlaces de acceso por correo. Hacen falta LOS DOS: con uno solo, el envío
# falla en el momento de usarlo y no al arrancar.
# EMAIL_SERVER="smtp://usuario:clave@smtp.proveedor.com:587"
EMAIL_SERVER=""
EMAIL_FROM=""
