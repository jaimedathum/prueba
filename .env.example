# Postgres (Neon, Supabase o local)
DATABASE_URL="postgresql://user:pass@host:5432/fantasy"

# Credenciales de LaLiga Fantasy Oficial.
# Solo se usan una vez, para el login inicial: a partir de ahí se guarda el
# refresh token CIFRADO en la base de datos y la contraseña deja de hacer falta.
# Recomendado: hacer el login una vez en local y no desplegar estas dos.
FANTASY_EMAIL=""
FANTASY_PASSWORD=""

# Clave AES-256-GCM para cifrar el refresh token en reposo (32 bytes en hex).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Identificador de la liga privada a analizar. Se descubre con `npm run sync -- --dry-run`.
FANTASY_LEAGUE_ID=""

# Secreto para proteger la ruta de cron (/api/cron/sync). Cualquier cadena larga y aleatoria.
CRON_SECRET=""

# Alertas por Telegram (opcional, fase 4)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
